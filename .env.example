# install.sh 会自动生成 /etc/xvpn-panel.env，通常无需手动编辑。
SECRET_KEY=auto-generated
FERNET_KEY=auto-generated
DATABASE_PATH=/var/lib/xvpn-panel/panel.db

# Fresh install bootstrap only. Username is fixed to admin.
ADMIN_PASSWORD=auto-generated-on-first-install

PANEL_NAME=XVPN Panel
PANEL_SUBTITLE=私人访问控制台

ADMIN_ALLOWED_IPS=
TRUST_PROXY=1
TOKEN_DAYS=30
COOKIE_SECURE=1

# Android App Latest Release source. Can also be edited later in Admin -> App Update.
XVPN_ANDROID_REPOSITORY=kkx999/XVPN-Android
