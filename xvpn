#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="/opt/xvpn-panel"
DATA_DIR="/var/lib/xvpn-panel"
ENV_FILE="/etc/xvpn-panel.env"
BACKUP_DIR="/var/backups/xvpn-panel"
NGINX_SITE="/etc/nginx/sites-available/xvpn-panel"
RELEASE_REPO="kkx999/xvpn"

need_root(){ [[ ${EUID} -eq 0 ]] || { echo "[ERROR] 请使用 root 运行 xvpn。" >&2; exit 1; }; }
current_version(){ [[ -f "$APP_DIR/VERSION" ]] && tr -d '[:space:]' < "$APP_DIR/VERSION" || echo unknown; }
current_domain(){ [[ -f "$NGINX_SITE" ]] && awk '/^[[:space:]]*server_name[[:space:]]+/ {gsub(/;/,"",$2);if($2!="_"){print $2;exit}}' "$NGINX_SITE" 2>/dev/null || true; }
database_path(){ awk -F= '/^DATABASE_PATH=/{print substr($0,index($0,"=")+1);exit}' "$ENV_FILE" 2>/dev/null || true; }

admin_path(){
  local db value
  db="$(database_path)"
  if [[ -n "$db" && -f "$db" ]]; then
    value="$(sqlite3 "$db" "SELECT value FROM system_settings WHERE key='admin_path' LIMIT 1;" 2>/dev/null | head -n1 || true)"
  fi
  value="${value:-admin}"; value="${value#/}"; value="${value%/}"
  echo "$value"
}

restart_panel(){
  need_root
  systemctl restart xvpn-panel
  sleep 1
  if systemctl is-active --quiet xvpn-panel; then
    echo "[OK] XVPN Panel 已重启。"
  else
    echo "[ERROR] Panel 重启失败。" >&2
    journalctl -u xvpn-panel -n 80 --no-pager
    return 1
  fi
}

set_admin_path(){
  need_root
  local value="${1:-}" db domain escaped
  value="${value#/}"; value="${value%/}"
  [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{2,47}$ ]] || { echo "[ERROR] 后台路径需为 3-48 位字母、数字、- 或 _。" >&2; return 2; }
  case "${value,,}" in api|static|assets|health) echo "[ERROR] 该路径为系统保留路径。" >&2; return 2;; esac
  db="$(database_path)"
  [[ -n "$db" && -f "$db" ]] || { echo "[ERROR] 找不到 Panel 数据库。" >&2; return 1; }
  escaped="${value//\'/\'\'}"
  sqlite3 "$db" "INSERT INTO system_settings(key,value,updated_at) VALUES('admin_path','$escaped',datetime('now')) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at;"
  chown xvpn-panel:xvpn-panel "$db" 2>/dev/null || true
  restart_panel
  domain="$(current_domain)"
  if [[ -n "$domain" ]]; then
    echo "[OK] 新后台：https://$domain/$value/login"
  else
    echo "[OK] 新后台路径：/$value/login"
  fi
  echo "旧后台路径已经失效，会直接返回 404。"
}

update_panel(){
  need_root
  local target="${1:-}"
  [[ -x "$APP_DIR/install-online.sh" ]] || { echo "[ERROR] 找不到在线更新器。" >&2; return 1; }
  if [[ -n "$target" ]]; then exec bash "$APP_DIR/install-online.sh" --version "$target"; fi
  exec bash "$APP_DIR/install-online.sh"
}

uninstall_panel(){
  need_root
  if [[ "${1:-}" != "--yes" ]]; then
    echo "⚠️  即将彻底删除 XVPN Panel。"
    echo "会删除：程序、数据库、用户/节点数据、配置、备份、systemd 服务和 Nginx Panel 站点。"
    echo "不会卸载 Nginx/Certbot，也不会主动删除 Let's Encrypt 证书。"
    read -r -p "输入 YES 继续：" confirm
    [[ "$confirm" == "YES" ]] || { echo "已取消。"; return 0; }
  fi

  systemctl stop xvpn-panel xvpn-panel-backup.timer xvpn-panel-backup.service 2>/dev/null || true
  systemctl disable xvpn-panel xvpn-panel-backup.timer xvpn-panel-backup.service 2>/dev/null || true
  rm -f /etc/systemd/system/xvpn-panel.service /etc/systemd/system/xvpn-panel-backup.service /etc/systemd/system/xvpn-panel-backup.timer
  rm -f /etc/nginx/sites-enabled/xvpn-panel /etc/nginx/sites-available/xvpn-panel
  rm -rf "$APP_DIR" "$DATA_DIR" "$BACKUP_DIR"
  rm -f "$ENV_FILE" /etc/xvpn-panel-update.conf /usr/local/bin/xvpn
  if id xvpn-panel >/dev/null 2>&1; then userdel xvpn-panel || true; fi
  systemctl daemon-reload
  systemctl reset-failed || true
  if command -v nginx >/dev/null 2>&1; then nginx -t && systemctl reload nginx || true; fi
  echo "[OK] XVPN Panel 已彻底卸载。"
  echo "Nginx / Certbot 和已有证书未删除。"
}

show_status(){ need_root; systemctl status xvpn-panel --no-pager || true; }
show_logs(){ need_root; journalctl -u xvpn-panel -n 80 -f; }
reset_password(){ need_root; (cd "$APP_DIR" && "$APP_DIR/.venv/bin/python" reset-admin-password.py); }
manage_domain(){ need_root; "$APP_DIR/domain-manager.sh"; }

menu(){
  need_root
  while true; do
    clear || true
    echo "XVPN Panel v$(current_version)"
    echo "后台路径：/$(admin_path)"
    echo "----------------------------------------"
    echo "1) 域名 / HTTPS 管理"
    echo "2) 查看服务状态"
    echo "3) 重启 Panel"
    echo "4) 查看实时日志"
    echo "5) 重置管理员密码"
    echo "6) 修改后台路径"
    echo "7) 更新 Panel"
    echo "8) 卸载并彻底清除"
    echo "0) 退出"
    read -r -p "请选择 [0-8]: " choice
    case "$choice" in
      1) manage_domain;;
      2) show_status;;
      3) restart_panel;;
      4) show_logs;;
      5) reset_password;;
      6) read -r -p "新的后台路径（例如 manage-xvpn）：" value; set_admin_path "$value";;
      7) update_panel;;
      8) uninstall_panel; return;;
      0) return 0;;
      *) echo "输入无效";;
    esac
    [[ "$choice" != "4" ]] && { echo; read -r -p "按 Enter 继续..." _ || true; }
  done
}

case "${1:-}" in
  "") menu;;
  status) show_status;;
  restart) restart_panel;;
  logs|log) show_logs;;
  password|passwd) reset_password;;
  domain|https) manage_domain;;
  update) update_panel "${2:-}";;
  admin-path)
    if [[ -n "${2:-}" ]]; then set_admin_path "$2"; else echo "当前后台路径：/$(admin_path)"; echo "修改：xvpn admin-path manage-xvpn"; fi
    ;;
  uninstall) uninstall_panel "${2:-}";;
  version) current_version;;
  help|-h|--help)
    cat <<'HELP'
XVPN Panel 命令：
  xvpn                       打开管理菜单
  xvpn status                查看服务状态
  xvpn restart               重启 Panel
  xvpn logs                  查看实时日志
  xvpn password              重置管理员密码
  xvpn domain                域名 / HTTPS 管理
  xvpn update [v1.0.0]       更新或安装指定版本
  xvpn admin-path NAME       修改后台路径并立即重启生效
  xvpn uninstall             彻底卸载并清除 Panel
  xvpn version               显示当前版本
HELP
    ;;
  *) echo "[ERROR] 未知命令：$1" >&2; exit 2;;
esac
