#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="/opt/vpn-panel"
NGINX_SITE="/etc/nginx/sites-available/vpn-panel"
GITHUB_REPO="kkx999/xvpn"
GITHUB_BRANCH="main"
ONLINE_URL="https://raw.githubusercontent.com/kkx999/xvpn/main/install-online.sh"

C_RESET='\033[0m'; C_BOLD='\033[1m'; C_DIM='\033[2m'; C_BLUE='\033[38;5;75m'; C_GREEN='\033[38;5;78m'; C_YELLOW='\033[38;5;214m'; C_RED='\033[38;5;203m'; C_GRAY='\033[38;5;245m'; C_CYAN='\033[38;5;81m'
say(){ echo -e "$*"; }; ok(){ say "${C_GREEN}✓${C_RESET} $*"; }; info(){ say "${C_BLUE}▶${C_RESET} $*"; }; warn(){ say "${C_YELLOW}!${C_RESET} $*"; }; err(){ say "${C_RED}✗${C_RESET} $*" >&2; }; pause(){ echo; read -r -p "按 Enter 返回菜单..." _ || true; }
need_root(){ [[ ${EUID} -eq 0 ]] || { err "请使用 root 运行 vpn。"; exit 1; }; }
current_version(){ [[ -f "$APP_DIR/VERSION" ]] && tr -d '[:space:]' < "$APP_DIR/VERSION" || echo "unknown"; }
service_state(){ systemctl is-active --quiet vpn-panel 2>/dev/null && echo running || echo stopped; }
backup_state(){ systemctl is-active --quiet vpn-panel-backup.timer 2>/dev/null && echo running || echo stopped; }
current_domain(){ [[ -f "$NGINX_SITE" ]] && awk '/^[[:space:]]*server_name[[:space:]]+/ {gsub(/;/,"",$2); if($2!="_"){print $2; exit}}' "$NGINX_SITE" 2>/dev/null || true; }
version_compare(){ python3 - "$1" "$2" <<'PY'
import re,sys
def k(v):
 v=v.strip().lstrip('vV'); m=re.fullmatch(r'(\d+)\.(\d+)\.(\d+)(?:[-._]?([A-Za-z]+)[-._]?(\d+)?)?',v)
 if not m:return None
 a,b,c=map(int,m.group(1,2,3)); label=(m.group(4) or '').lower(); n=int(m.group(5) or 0); rank={'dev':10,'alpha':20,'a':20,'beta':30,'b':30,'rc':40,'':100}.get(label,50); return a,b,c,rank,n,label
A,B=k(sys.argv[1]),k(sys.argv[2])
print('unknown' if A is None or B is None else 'newer' if A>B else 'same' if A==B else 'older')
PY
}
valid_version(){ [[ "$1" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+([._-]?[A-Za-z]+([._-]?[0-9]+)?)?$ ]]; }

check_update(){
  need_root
  local cur remote cmp
  cur="$(current_version)"
  info "正在检查 GitHub：$GITHUB_REPO"
  remote="$(curl -fsSL --connect-timeout 8 --max-time 15 "https://raw.githubusercontent.com/$GITHUB_REPO/$GITHUB_BRANCH/VERSION" 2>/dev/null | tr -d '[:space:]' || true)"
  if [[ -z "$remote" ]]; then
    warn "暂时无法读取 GitHub VERSION。"
    say "仓库：${C_CYAN}https://github.com/$GITHUB_REPO${C_RESET}"
    return 1
  fi
  cmp="$(version_compare "$remote" "$cur")"
  say "当前版本：${C_GRAY}v$cur${C_RESET}"
  say "GitHub：   ${C_CYAN}v$remote${C_RESET}"
  case "$cmp" in
    newer)
      warn "检测到新版本。"
      echo
      say "升级最新版本：${C_CYAN}vpn update${C_RESET}"
      say "指定此版本：  ${C_CYAN}vpn update v$remote${C_RESET}"
      ;;
    same) ok "当前已经是最新版本。" ;;
    older) ok "当前安装版本高于 GitHub main 分支。" ;;
    *) warn "无法可靠比较版本号。" ;;
  esac
}

update_panel(){
  need_root
  local target="${1:-}"
  if [[ -n "$target" ]]; then
    valid_version "$target" || { err "版本格式无效，例如：vpn update v1.0.0 或 vpn update v1.0.0-rc1"; return 2; }
    target="${target#v}"; target="${target#V}"
    info "准备安装指定版本：v$target"
    exec bash -c 'bash <(curl -fsSL "$1") --version "$2"' _ "$ONLINE_URL" "v$target"
  else
    info "准备从 GitHub main 部署最新版本。"
    exec bash -c 'bash <(curl -fsSL "$1")' _ "$ONLINE_URL"
  fi
}

show_status(){ need_root; echo; systemctl status vpn-panel --no-pager || true; echo; systemctl status nginx --no-pager || true; echo; systemctl status vpn-panel-backup.timer --no-pager || true; }
restart_panel(){ need_root; info "正在重启 VPN Panel..."; systemctl restart vpn-panel; sleep 1; systemctl is-active --quiet vpn-panel && ok "VPN Panel 已正常重启。" || { err "重启失败。"; journalctl -u vpn-panel -n 60 --no-pager; return 1; }; }
show_logs(){ need_root; say "${C_DIM}按 Ctrl+C 退出实时日志。${C_RESET}"; journalctl -u vpn-panel -n 80 -f; }
reset_password(){ need_root; [[ -x "$APP_DIR/.venv/bin/python" && -f "$APP_DIR/reset-admin-password.py" ]] || { err "找不到密码重置工具。"; return 1; }; (cd "$APP_DIR" && "$APP_DIR/.venv/bin/python" reset-admin-password.py); }
manage_domain(){ need_root; [[ -x "$APP_DIR/domain-manager.sh" ]] || { err "域名管理工具不存在。"; return 1; }; "$APP_DIR/domain-manager.sh"; }
show_header(){
  local v state bstate domain
  v="$(current_version)"; state="$(service_state)"; bstate="$(backup_state)"; domain="$(current_domain)"
  clear || true
  say "${C_BOLD}${C_BLUE}VPN Panel 管理菜单${C_RESET}"
  say "────────────────────────────────────────"
  say "版本       ${C_CYAN}v$v${C_RESET}"
  [[ "$state" == running ]] && say "Panel      ${C_GREEN}● 运行中${C_RESET}" || say "Panel      ${C_RED}● 未运行${C_RESET}"
  [[ "$bstate" == running ]] && say "自动备份   ${C_GREEN}● 定时器正常${C_RESET}" || say "自动备份   ${C_YELLOW}● 定时器未运行${C_RESET}"
  [[ -n "$domain" ]] && say "后台       ${C_CYAN}https://$domain/admin/login${C_RESET}" || say "后台       ${C_YELLOW}未配置域名${C_RESET}"
  say "GitHub     ${C_CYAN}$GITHUB_REPO${C_RESET}"
  say "────────────────────────────────────────"
}
menu(){
  need_root
  while true; do
    show_header; echo
    say "  ${C_BOLD}1${C_RESET}) 检查 GitHub 是否有新版本"
    say "  ${C_BOLD}2${C_RESET}) 域名 / HTTPS 管理"
    say "  ${C_BOLD}3${C_RESET}) 查看服务状态"
    say "  ${C_BOLD}4${C_RESET}) 重启 Panel"
    say "  ${C_BOLD}5${C_RESET}) 查看实时日志"
    say "  ${C_BOLD}6${C_RESET}) 重置 admin 密码"
    say "  ${C_BOLD}0${C_RESET}) 退出"
    echo
    read -r -p "请选择 [0-6]: " choice
    case "$choice" in
      1) echo; check_update || true; pause ;;
      2) echo; manage_domain || true; pause ;;
      3) show_status; pause ;;
      4) echo; restart_panel || true; pause ;;
      5) show_logs || true ;;
      6) reset_password || true; pause ;;
      0) echo "已退出。"; return 0 ;;
      *) warn "请输入 0 到 6。"; sleep 1 ;;
    esac
  done
}
case "${1:-}" in
  "") menu ;;
  check|check-update) check_update ;;
  update) update_panel "${2:-}" ;;
  domain|https) manage_domain ;;
  status) show_status ;;
  restart) restart_panel ;;
  logs|log) show_logs ;;
  password|passwd) reset_password ;;
  version) current_version ;;
  help|-h|--help) cat <<'HELP'
VPN Panel 命令：
  vpn                         打开中文管理菜单
  vpn check                   检查 GitHub 新版本
  vpn update                  部署 GitHub main 最新版本
  vpn update v1.0.0           安装指定 GitHub Release / Tag 版本
  vpn domain                  配置/更换域名并申请 HTTPS
  vpn status                  查看服务状态
  vpn restart                 重启 Panel
  vpn logs                    查看实时日志
  vpn password                重置 admin 密码
  vpn version                 显示当前版本
HELP
  ;;
  *) err "未知命令：$1"; say "执行 vpn help 查看可用命令。"; exit 2 ;;
esac
